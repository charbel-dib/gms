# --- required in production ---
NODE_ENV=production
PORT=8080
# Either a full URL...
DATABASE_URL=postgres://gms:password@host:5432/gms?sslmode=require
# ...or discrete parts (used on AWS ECS, injected from Secrets Manager)
# DB_HOST= DB_PORT=5432 DB_NAME=gms DB_USER= DB_PASSWORD= DB_SSLMODE=verify-full
# DB_CA_FILE=/app/rds-ca.pem
PUBLIC_URL=https://app.gms.lb
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
SUPERADMIN_EMAIL=you@yourdomain.com
SUPERADMIN_PASSWORD=strong-password-for-first-start
TRUST_PROXY=true

# --- AI (optional: without it, GMS runs its offline AI mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- WhatsApp Business Platform (optional: default is click-to-send) ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Background jobs (reminders, churn scoring, class generation)
JOBS_ENABLED=true
